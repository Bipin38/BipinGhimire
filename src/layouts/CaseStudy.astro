---
import Base from './Base.astro';
import { bySlug } from '../data/projects';
import { profile } from '../data/profile';
import { withBase } from '../lib/theme';

interface Props {
  frontmatter: { slug: string };
}
const p = bySlug(Astro.props.frontmatter.slug);
const back =
  p.kind === 'research'
    ? { href: withBase('#data-ai'), label: 'Research' }
    : { href: withBase('#work'), label: 'Selected work' };
const row = 'border-line grid gap-x-8 gap-y-1 border-t py-3 sm:grid-cols-[7.5rem_1fr]';
---

<Base title={`${p.title} — Case study · ${profile.name}`} description={p.problem}>
  <article class="grid gap-8 pt-12 pb-8 md:pt-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-3">
      <a href={back.href} class="arrow-link">
        <span aria-hidden="true">←</span> {back.label}
      </a>
    </div>

    <div class="min-w-0 lg:col-span-9">
      <p class="label">
        <span class="text-accent">Case study</span> · {p.org} · {p.period}
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl md:text-5xl">{p.title}</h1>
      <p class="mt-3 font-mono text-xs text-accent">
        {p.area}
        {p.status && <span class="text-muted"> · {p.status}</span>}
      </p>
      <p class="text-muted mt-6 max-w-[68ch] text-lg leading-relaxed">{p.problem}</p>

      <dl class="border-line mt-10 border-b">
        <div class={row}>
          <dt class="label pt-0.5">Stack</dt>
          <dd>
            <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
              {p.stack.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
          </dd>
        </div>
        <div class={row}>
          <dt class="label pt-0.5">Result</dt>
          <dd>
            <ul class="space-y-1.5">
              {p.results.map((r) => (
                <li class="before:text-accent before:mr-2 before:align-middle before:text-[0.6em] before:content-['■']">
                  {r}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <div class="prose mt-4">
        <slot />
      </div>

      <p class="border-line mt-16 border-t pt-6">
        <a href={back.href} class="arrow-link">
          <span aria-hidden="true">←</span> Back to {back.label.toLowerCase()}
        </a>
      </p>
    </div>
  </article>
</Base>
