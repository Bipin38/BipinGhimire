---
interface Props {
  id: string;
  n: string;
  title: string;
}
const { id, n, title } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class="border-line grid gap-8 border-t py-16 md:py-20 lg:grid-cols-12 lg:gap-10 lg:py-24"
>
  <div class="lg:col-span-3">
    <div class="lg:sticky lg:top-24">
      <p class="font-mono text-xs text-accent" aria-hidden="true">
        {n}
      </p>
      <h2 id={`${id}-title`} class="mt-1 text-2xl font-medium tracking-tight">
        {title}
      </h2>
    </div>
  </div>
  <div class="min-w-0 lg:col-span-9">
    <slot />
  </div>
</section>
