---
// Numbered architecture diagram for case studies. A list, so it reads correctly without CSS.
interface Props {
  caption: string;
  steps: { title: string; detail: string }[];
}
const { caption, steps } = Astro.props;
---

<figure class="ticks my-10 p-4 sm:p-6">
  <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(9.5rem,1fr))]">
    {steps.map((s, i) => (
      <li class="border-line bg-surface border p-3">
        <span class="font-mono text-[0.7rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
        <p class="mt-1 text-sm font-medium">{s.title}</p>
        <p class="text-muted mt-1 text-xs leading-snug">{s.detail}</p>
      </li>
    ))}
  </ol>
  <figcaption class="label mt-4 normal-case">{caption}</figcaption>
</figure>
